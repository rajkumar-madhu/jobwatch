{
  "realm": "cronsentinel",
  "enabled": true,
  "displayName": "WeCrew JobWatch",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,

  "defaultSignatureAlgorithm": "RS256",

  "clients": [
    {
      "clientId": "cronsentinel-web",
      "name": "JobWatch web",
      "description": "Confidential, server-side authorization-code client. Backs apps/api/cronsentinel/routers/auth.py: the API exchanges the code for tokens itself, so the secret never reaches a browser.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:8000/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000"
      },
      "defaultClientScopes": ["openid", "email", "profile"],
      "optionalClientScopes": []
    }
  ]
}
