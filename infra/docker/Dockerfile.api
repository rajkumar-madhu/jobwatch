FROM python:3.12-slim
WORKDIR /app
# psycopg[binary] ships libpq, so the image does not need apt (Debian mirrors 403 under cross-build).
COPY apps/api/pyproject.toml ./
COPY apps/api/cronsentinel ./cronsentinel
COPY apps/api/alembic ./alembic
COPY apps/api/alembic.ini ./
RUN pip install --no-cache-dir -e . \
 && useradd --uid 10001 --create-home --shell /usr/sbin/nologin jobwatch \
 && chown -R jobwatch:jobwatch /app
USER 10001
EXPOSE 8000 8010
CMD ["uvicorn", "cronsentinel.main:app", "--host", "0.0.0.0", "--port", "8000"]
